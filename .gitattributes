# 强制 LF 换行 —— 这对 shell 脚本是硬性要求。
# Windows 上 Git 默认会转成 CRLF，导致拷到 Linux 后
# `bash: xxx.sh: /bin/sh^M: bad interpreter` 或 `$'\r': command not found`。
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.md  text eol=lf
*.conf text eol=lf
*.service text eol=lf

# 二进制（虽然当前仓库没有，防未来误加）
*.png binary
*.jpg binary
*.ico binary
*.nmconnection text eol=lf
